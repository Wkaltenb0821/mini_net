From bafcd485401583fdf5bfe61d86baec89296dc545 Mon Sep 17 00:00:00 2001
From: rsm0012 <rsanchezmendoza@luc.edu>
Date: Wed, 4 Nov 2026 21:52:05 -0600
Subject: [PATCH] Use python3 -m http.server in testSimpleHTTP

---
 mininet/test/test_walkthrough.py | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/mininet/test/test_walkthrough.py b/mininet/test/test_walkthrough.py
index 2df724f..96647af 100755
--- a/mininet/test/test_walkthrough.py
+++ b/mininet/test/test_walkthrough.py
@@ -165,13 +165,10 @@ def testConnectivity( self ):
 
     def testSimpleHTTP( self ):
         "Start an HTTP server on h1 and wget from h2"
-        if 'Python 2' in quietRun( 'python --version' ):
-            httpserver = 'SimpleHTTPServer'
-        else:
-            httpserver = 'http.server'
+        httpserver = 'http.server'
         p = pexpect.spawn( 'mn -w', logfile=stdout )
         p.expect( self.prompt )
-        p.sendline( 'h1 python -m %s 80 >& /dev/null &' % httpserver )
+        p.sendline( 'h1 python3 -m %s 80 >& /dev/null &' % httpserver )
         p.expect( self.prompt )
         # The walkthrough doesn't specify a delay here, and
         # we also don't read the output (also a possible problem),
-- 
